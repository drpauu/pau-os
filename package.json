    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "supabase": "2.120.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "type": "module",
  "overrides": {
    "compression": "1.8.2"
