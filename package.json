    "format": "prettier --write app components features hooks lib stores tests scripts",
    "content:seed": "node scripts/export-seed.mjs",
    "sync:toolbox": "node scripts/sync-toolbox.mjs",
    "prebuild": "npm run sync:toolbox",
    "resume:generate": "node scripts/generate-public-resume.mjs",
    "capture:assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.2.0",
    "@supabase/supabase-js": "2.117.3",
    "gsap": "3.15.0",
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
